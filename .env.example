# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Telegram Bot notifications (server-side only, never expose to client)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Sheets Apps Script Web App URL (2-way read & write without user login)
GOOGLE_SHEETS_WEBHOOK_URL=

# Optional: Public/shared Google Sheet ID for read-only initial sync if webhook URL is not set
GOOGLE_SHEET_ID=

# Optional: Overdue Accounts Receivable (AR) Google Sheet ID & Apps Script webhook
AR_GOOGLE_SHEET_ID=
AR_SHEETS_WEBHOOK_URL=
